digraph G { graph [rankdir=TB,bgcolor="transparent"]; node [shape=box,style="rounded,filled",fontname="Noto Sans CJK SC",fontsize=10,fillcolor="#F7F8FA",color="#35495E"]; edge [fontname="Noto Sans CJK SC",fontsize=9,color="#708090"]; a[label="ECU A 与 ECU B\n同时发送 SOF/ID"]; b[label="每发 1 bit 同时读总线"]; c[label="发送 1 但读到 0？",shape=diamond,fillcolor="#FFF7E6"]; d[label="仲裁失败\n立即停止发送"]; e[label="继续发送剩余帧"]; f[label="总线空闲后再次竞争"]; a->b->c; c->d[label="是"]; c->e[label="否"]; d->f; }