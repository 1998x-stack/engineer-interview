digraph G { graph [rankdir=LR,bgcolor="transparent"]; node [shape=box,style="rounded,filled",fontname="Noto Sans CJK SC",fontsize=10,color="#35495E"]; edge [color="#708090"]; a[label="Arbitration Phase\nNominal Bit Rate",style="rounded,filled",fillcolor="#E8F1FB"]; b[label="FDF/BRS/ESI",style="rounded,filled",fillcolor="#F7F8FA"]; c[label="Data Phase\nup to 64 Byte\nHigher Bit Rate (optional)",style="rounded,filled",fillcolor="#EAF7EE"]; d[label="CRC/ACK/EOF\n按协议规定切换",style="rounded,filled",fillcolor="#F7F8FA"]; a->b->c->d; }